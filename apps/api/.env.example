BACKBLAZE_REGION=eu-central-003
BACKBLAZE_KEY_ID=
BACKBLAZE_APP_KEY=
BACKBLAZE_BUCKET_NAME=drvenija-images
RESEND_API_KEY=
ORDER_EMAIL_FROM=Drvenija <narudzbe@your-domain.com>
