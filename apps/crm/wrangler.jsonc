{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The CRM is a static single-page app: Cloudflare serves the Vite build and answers
  // unknown paths (e.g. /orders/<id>) with index.html. Static requests are free.
  "name": "drvenija-crm",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
