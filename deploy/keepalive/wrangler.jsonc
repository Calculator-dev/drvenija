{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "drvenija-keepalive",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    // Set to the API's public address (the Render URL or your API domain).
    "API_URL": "https://drvenija-api.onrender.com"
  }
}
